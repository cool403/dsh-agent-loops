{
  "name": "dsh-agent-loops",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: every task's agent loops, with the model calls, tool calls, and prompts inside each one.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cool403/dsh-agent-loops.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "observability",
    "session-projection"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
